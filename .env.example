# ============================================================
# AI Platform - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=ai_platform

# --- Auth ---
JWT_SECRET=change_me_to_a_random_secret_string_at_least_32_chars
JWT_EXPIRY_HOURS=24

# --- Ollama ---
# Point this to your Ollama server. If running on the same host,
# use http://host.docker.internal:11434 (Docker handles the routing).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Model names (must match what's pulled in Ollama) ---
MODEL_GENERAL=qwen3:8b-fp16
MODEL_COMPLEX=qwen3:32b-fp16
MODEL_CODING=qwen2.5-coder:32b-instruct-fp16
MODEL_EMBEDDINGS=bge-m3:latest
MODEL_FAST=qwen3:4b-fp16

# --- Ports ---
FRONTEND_PORT=4400
BACKEND_PORT=4300
POSTGRES_PORT=49532
REDIS_PORT=38921
QDRANT_PORT=57388
